{
  "name": "portafolio-digital",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "serve out --listen tcp://127.0.0.1:3000",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
