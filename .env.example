# Variables de entorno del portafolio
# Copiar este archivo a .env.local y rellenar los valores reales.
# Nunca subir .env.local a Git (está en .gitignore).

# URL de producción del sitio (requerida para metadatos Open Graph absolutos)
# Ejemplo: https://maxacosta.com
NEXT_PUBLIC_SITE_URL=

# Google Analytics (GA4) — Measurement ID público, se expone en el HTML
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — token de verificación por meta tag, público en el HTML
NEXT_PUBLIC_GSC_VERIFICATION=
